{
  "name": "@semanticauth/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "jev:eval": "tsx --env-file-if-exists=../../.env scripts/jev-eval.ts",
    "eval": "tsx --env-file-if-exists=../../.env eval/cli/run.ts",
    "eval:fetch": "tsx eval/cli/fetch.ts",
    "eval:build": "tsx eval/cli/build.ts",
    "eval:validate": "tsx eval/cli/validate.ts",
    "eval:label": "tsx eval/cli/label.ts",
    "eval:report": "tsx eval/cli/report.ts",
    "eval:tune": "tsx eval/cli/tune.ts",
    "eval:compare": "tsx eval/cli/compare.ts",
    "eval:common": "tsx eval/cli/common.ts",
    "eval:ablation": "tsx eval/cli/ablation.ts",
    "eval:variants": "tsx eval/cli/variants.ts",
    "eval:stability": "tsx --env-file-if-exists=../../.env eval/cli/stability.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1153.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@semanticauth/contracts": "^0.0.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
