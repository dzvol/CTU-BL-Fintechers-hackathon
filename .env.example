# --- Gateway ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
WEB_BASE_URL=http://localhost:5173
DATABASE_PATH=./data/semanticauth.db

# --- Dashboard auth (Google OAuth) ---
# Leave empty to run the gateway without login (auth routes answer 503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" of the OAuth client. Dev goes through the Vite proxy.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Signs the OAuth state cookie. Generate: openssl rand -hex 32. Required in production.
SESSION_SECRET=

# --- Jev (Screen + Judge) ---
# TypeSafe Jev API (POST <url>/v1/systemone). Without a key every paid offer is blocked.
JEV_API_URL=https://api.typesafe.ai
JEV_API_KEY=
# Pinned model version; avoid aliases like jev-latest, they can change behaviour.
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=10000

# --- Payments: shared sponsor EOA on Base Sepolia ---
# NEVER commit a real key. Server-side secret only, never exposed to the agent.
SPONSOR_PRIVATE_KEY=
# Optional public address of the shared EOA; Signer rejects a secret belonging to another wallet.
SPONSOR_ADDRESS=
# Signer caps authorization lifetime at this many seconds and at the merchant's maxTimeoutSeconds.
SIGNER_AUTHORIZATION_TTL_SECONDS=120
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Independent read-only verification. Switch to base-mainnet to use Base and its native USDC.
CHAIN_READER_NETWORK=base-sepolia
# Optional RPC override; empty uses the selected network's default (or BASE_SEPOLIA_RPC_URL on Sepolia).
CHAIN_READER_RPC_URL=
CHAIN_READER_CONFIRMATIONS=1
CHAIN_READER_TIMEOUT_MS=10000
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_FACILITATOR_URL=https://x402.org/facilitator

# Dev only: let the gateway call merchants over plain HTTP on localhost (tests/merchants).
# Keep false in production: merchants must be HTTPS.
X402_ALLOW_HTTP_LOCALHOST=true

# --- Sponsored ledger ---
# Per-user allocation assigned on first Google login (USDC, decimal string). Once a user has
# spent it, their API keys stop working and no new key can be created.
USER_ALLOCATION_USDC=5
# Total the sponsor pool hands out over all users (USDC, decimal string). Keep it at or below
# the sponsor wallet's USDC balance; a reservation that doesn't fit is blocked.
SPONSOR_POOL_USDC=20

# --- Test merchants (tests/merchants) ---
MERCHANTS_PORT=4021
# Address that receives test payments. Public address only, no key needed. Never the sponsor wallet.
MERCHANT_PAY_TO=
# Only for the manual pay-once smoke test (npm run pay -w @semanticauth/test-merchants).
# Throwaway test wallet with Base Sepolia USDC. NEVER the sponsor key, never commit a real value.
TEST_BUYER_PRIVATE_KEY=
MERCHANTS_BASE_URL=http://localhost:4021
